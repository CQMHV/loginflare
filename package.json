{
    "name": "loginflare",
    "version": "0.1.0",
    "packageManager": "pnpm@11.25.0",
    "private": true,
    "type": "module",
    "license": "(MIT OR Apache-2.0)",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "node scripts/migration-bundle.mjs && node scripts/licenses.mjs && vite build",
        "licenses:generate": "node scripts/licenses.mjs",
        "typecheck": "node scripts/migration-bundle.mjs && wrangler types --config wrangler.local.jsonc && node examples/worker-api/generate-types.mjs && node examples/management-worker/generate-types.mjs && tsc --noEmit",
        "test": "node scripts/migration-bundle.mjs && vitest run",
        "test:e2e": "playwright test",
        "test:ops": "node --test scripts/database.test.mjs scripts/database-schema.test.mjs scripts/deployment.test.mjs scripts/migration-bundle.test.mjs",
        "example:web": "node --env-file-if-exists=examples/server-web/.env examples/server-web/server.mjs",
        "example:spa": "vite --config examples/spa/vite.config.ts",
        "example:tls": "node examples/setup-tls.mjs",
        "example:api": "wrangler dev --config examples/worker-api/wrangler.jsonc --port 5183",
        "example:management": "wrangler dev --config examples/management-worker/wrangler.jsonc --port 5184 --test-scheduled",
        "db:migrate": "node scripts/database.mjs migrate --local",
        "db:check": "node scripts/database.mjs check --local",
        "db:backup": "node scripts/local-snapshot.mjs",
        "test:scale": "node scripts/scale.mjs",
        "admin:promote": "node scripts/database.mjs promote",
        "types": "wrangler types --config wrangler.local.jsonc",
        "setup:local": "node scripts/setup-local.mjs",
        "check": "pnpm typecheck && pnpm test && pnpm test:ops && pnpm build",
        "build:deploy": "node scripts/migration-bundle.mjs && node scripts/licenses.mjs && vite build --mode deployment",
        "deploy": "node scripts/deployment.mjs"
    },
    "dependencies": {
        "@better-auth/oauth-provider": "1.7.13",
        "@dnd-kit/dom": "0.5.3",
        "@dnd-kit/react": "0.5.3",
        "@fontsource-variable/noto-sans-sc": "5.3.1",
        "@fontsource-variable/roboto": "5.3.0",
        "@material-symbols/svg-500": "0.45.8",
        "@material/material-color-utilities": "0.3.0",
        "@material/web": "2.5.0",
        "@tanstack/react-query": "5.105.0",
        "@xmldom/xmldom": "0.9.12",
        "better-auth": "1.7.13",
        "hono": "4.13.14",
        "i18next": "26.5.11",
        "jose": "6.2.13",
        "qrcode.react": "4.2.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-easy-crop": "6.2.4",
        "react-i18next": "17.1.9",
        "react-router-dom": "7.18.4",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.65.0",
        "@cloudflare/vitest-plugin": "1.4.8",
        "@cloudflare/workers-types": "5.20261026.1",
        "@playwright/test": "1.64.1",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "cf": "1.0.0-beta.22",
        "miniflare": "4.20260730.0",
        "oidc-client-ts": "3.5.0",
        "openid-client": "6.8.8",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.5",
        "wrangler": "4.152.0"
    },
    "cloudflare": {
        "bindings": {
            "CF_SETUP_TOKEN": {
                "description": "First installation only: a scoped **Cloudflare User API Token**, not an Account API Token. Limit it to your account and chosen zones. [Required permissions and setup](https://github.com/CQMHV/loginflare/blob/main/docs/deployment.md). The wizard deletes this secret; later deployments do not need it."
            },
            "DB": {
                "description": "Account database. Cloudflare creates and binds it automatically. Keep the same database on future deployments."
            },
            "AVATARS": {
                "description": "Private object storage for avatars, branding and provider icons. Keep public bucket access disabled."
            },
            "EMAIL": {
                "description": "Cloudflare Email Service binding. Sending to arbitrary users requires Workers Paid and an onboarded sending domain; the wizard checks configuration."
            }
        }
    }
}
